###############################################################################
# tp-gen — Environment Variables
#
# For LOCAL development: fill in the Supabase cloud values (VITE_* only needed)
# For PRODUCTION (self-hosted): copy to .env and fill in ALL values.
# NEVER commit .env to git.
#
# ─── KEY GENERATION ──────────────────────────────────────────────────────────
#   JWT_SECRET:                openssl rand -base64 32
#   REALTIME_SECRET_KEY_BASE:  openssl rand -base64 64
#   PLAUSIBLE_SECRET_KEY_BASE: openssl rand -base64 64
#
#   ANON_KEY / SERVICE_ROLE_KEY:
#     → https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
#     Or use jwt.io (HS256) with these payloads signed by JWT_SECRET:
#       ANON_KEY:        { "role": "anon", "iss": "supabase", "iat": <now>, "exp": <+1yr> }
#       SERVICE_ROLE_KEY:{ "role": "service_role", "iss": "supabase", "iat": <now>, "exp": <+1yr> }
###############################################################################

# ─── DOMAIN (production only) ─────────────────────────────────────────────────
DOMAIN=your-domain.com

# ─── SUPABASE CORE ────────────────────────────────────────────────────────────
# Local dev: use Supabase cloud values
# Production: generate new keys for self-hosted instance
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

POSTGRES_PASSWORD=change-me-strong-db-password
JWT_SECRET=change-me-minimum-32-chars-random-string

# JWT tokens (anon + service_role) — production self-hosted only
ANON_KEY=
SERVICE_ROLE_KEY=

# ─── SUPABASE URLS (production only) ─────────────────────────────────────────
API_EXTERNAL_URL=https://your-domain.com
SITE_URL=https://your-domain.com
ADDITIONAL_REDIRECT_URLS=https://your-domain.com/auth/callback

# ─── VITE BUILD VARS ──────────────────────────────────────────────────────────
# Local dev
VITE_REDIRECT_URL=http://localhost:5173/auth/callback
# Production (set to production URL):
# VITE_REDIRECT_URL=https://your-domain.com/auth/callback

# ─── SUPABASE AUTH EMAILS (via Resend SDK — no SMTP) ─────────────────────────
# GoTrue calls the send-auth-email edge function instead of using SMTP.
# The function signs requests with GOTRUE_HOOK_SECRET; the edge function verifies it.
#
# Generate hook secret: openssl rand -hex 32
GOTRUE_HOOK_SECRET=

AUTH_EMAIL_FROM=noreply@your-domain.com
AUTH_EMAIL_FROM_NAME=zenit-it

# ─── SUPABASE REALTIME (production only) ─────────────────────────────────────
# Phoenix secret key base — different from JWT_SECRET
REALTIME_SECRET_KEY_BASE=

# ─── SUPABASE STUDIO (production only) ────────────────────────────────────────
# Basic auth for Kong dashboard route (access via SSH tunnel to localhost:3001)
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=change-me-dashboard-password

# ─── EDGE FUNCTIONS ───────────────────────────────────────────────────────────
# Used by send-feedback-email and send-auth-email functions
RESEND_API_KEY=re_your_resend_api_key

# ─── DATABASE MIGRATIONS (local Supabase CLI) ─────────────────────────────────
DB_PW=your_database_password

# ─── PLAUSIBLE ANALYTICS (production only) ────────────────────────────────────
# No SMTP/mailer configured — use CLI to manage admin accounts:
#   docker exec tp-gen-plausible /app/bin/plausible accounts
PLAUSIBLE_BASE_URL=https://analytics.your-domain.com
PLAUSIBLE_SECRET_KEY_BASE=
PLAUSIBLE_DB_PASSWORD=change-me-plausible-db-password
PLAUSIBLE_CLICKHOUSE_PASSWORD=change-me-clickhouse-password
