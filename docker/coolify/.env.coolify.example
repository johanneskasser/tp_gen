# ===========================================================================
# Coolify CI/CD — Environment Variables
# Add these entries to your main .env file.
# ===========================================================================

# Laravel app key — generate with:
#   docker run --rm ghcr.io/coollabsio/coolify php artisan key:generate --show
# Result looks like: base64:abc123...==
COOLIFY_APP_KEY=base64:REPLACE_WITH_GENERATED_KEY

# WebSocket keys — any random strings work, e.g.:
#   openssl rand -hex 32
COOLIFY_REVERB_APP_KEY=REPLACE_WITH_RANDOM_STRING
COOLIFY_REVERB_APP_SECRET=REPLACE_WITH_RANDOM_STRING
